        <mxCell id="r4" value="Rendered screen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1b5e20;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="frontend" target="customer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
