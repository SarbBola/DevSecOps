            <mxPoint as="offset" x="0" y="-12"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="The server checks permissions and validates input before it reads or changes data. The browser cannot be trusted to enforce those rules. A person or an attacker can change anything that runs in the client.&#xa;&#xa;Attack points — risk only. Nothing here was tested against a live service.&#xa;1  Weak login, on Authentication. A guessed, stolen, or skipped password check can open another customer's accounts.&#xa;2  Injection, on the API gateway. A crafted request can try to change a query. The gateway and the services must check every input.&#xa;3  XSS, on the React frontend. Text drawn as HTML can run as script in the browser and take the session. The screen is not the security boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e7;strokeColor=#d6b656;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;verticalAlign=top;fontColor=#1f2933;" vertex="1" parent="1">
