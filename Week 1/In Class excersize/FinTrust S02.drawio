          </mxGeometry>
        </mxCell>
        <mxCell id="r2" value="login result on screen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1b5e20;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="frontend" target="input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="408" y="500"/>
              <mxPoint x="130" y="500"/>
            </Array>
            <mxPoint as="offset" x="0" y="-12"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Trust boundary: left of the red line is the browser. It shows the form and keeps the token it is given. It does not decide that a password is correct. Right of the line is the server. Auth looks up the account, compares the password with the stored hash, and only then signs a JWT.&#xa;&#xa;Attack points — risk only. Nothing here was tested against a live service.&#xa;1  Weak login, on the Auth API. A weak password, no lockout, or a skipped hash check lets someone sign in as another customer.&#xa;2  Injection, on the login request at the API gateway. The email field can be crafted to change the lookup. The server treats that input as untrusted.&#xa;3  XSS, on the frontend. A script injected into the page can read the JWT in the browser. The page has to render text as text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e7;strokeColor=#d6b656;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;verticalAlign=top;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="20" y="748" width="1640" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="In class — FinTrust" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="1280" y="924" width="380" height="22" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
